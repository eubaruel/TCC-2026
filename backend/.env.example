PORTA= 

URI_BD= 
NOME_BD= 

# Rate limit: contadores no mesmo MongoDB de URI_BD/NOME_BD por padrao.
# As cotas por IP sao compartilhadas pelos usuarios da mesma rede.
RATE_LIMIT_GLOBAL=3000 per minute;30000 per hour
RATE_LIMIT_ROUTE=600 per minute
RATE_LIMIT_LOGIN_IP=300 per minute
RATE_LIMIT_LOGIN_REGISTRO=10 per minute
RATE_LIMIT_CORRECAO=120 per minute
RATE_LIMIT_IMPORTACAO=30 per minute
# Opcional: outro armazenamento compativel (memory:// somente para testes).
# RATELIMIT_STORAGE_URI=
# Quantidade de proxies confiaveis na frente da API. Zero ignora X-Forwarded-For.
TRUSTED_PROXY_HOPS=0

